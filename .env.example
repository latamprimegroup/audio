# Caminho do binário ffmpeg (padrão: /usr/bin/ffmpeg)
# FFMPEG_PATH=/usr/bin/ffmpeg

# Liga o botão "Testar" (transcrição AssemblyAI do canal mono)
# ASSEMBLYAI_API_KEY=

# Se definido, todas as rotas /api/cliente/googleads/audio-mix* exigem:
#   Authorization: Bearer <token>
# Sem valor = acesso aberto (somente para local/dev)
# AUDIO_STUDIO_TOKEN=

# Mesmo token no cliente (painel envia Authorization)
# NEXT_PUBLIC_AUDIO_STUDIO_TOKEN=
